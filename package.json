{
  "name": "markdown-log",
  "version": "0.2.0",
  "description": "Markdown Log Tracker",
  "type": "module",
  "main": "src/commands/mlog.js",
  "scripts": {
    "lint": "eslint src",
    "test": "c8 mocha --reporter spec test/**/*.test.js",
    "test:mocha": "mocha --reporter spec test/**/*.test.js",
    "test:watch": "mocha --reporter min test/**/*.test.js --watch",
    "preversion": "npm run lint && npm test",
    "version": "git add src",
    "postversion": "git push && git push --tags",
    "mlog": "node src/commands/mlog.js",
    "mlog-debug": "DEBUG=mlog:* node src/commands/mlog.js",
    "server": "DEBUG=mlog:* node --watch-path=src/server src/server/index.js"
  },
  "author": {
    "name": "Jonathan Keller",
    "email": "keller.jonathan@gmail.com"
  },
  "license": "GPL-3.0+",
  "repository": {
    "type": "git",
    "url": "https://github.com/kellerj/mlog.git"
  },
  "bin": {
    "mlog": "./src/commands/mlog.js"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "date-fns": "^4.1.0",
    "debug": "^4.4.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "marked": "^15.0.7",
    "morgan": "^1.10.0",
    "open": "^10.1.0",
    "serve-favicon": "^2.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "c8": "^10.1.3",
    "chai": "^5.1.2",
    "eslint": "^9.20.0",
    "globals": "^15.14.0",
    "mocha": "^11.1.0",
    "sinon": "^19.0.2",
    "tmp": "^0.2.3"
  },
  "c8": {
    "exclude": [
      "src/commands/**"
    ],
    "include": [
      "src/**"
    ],
    "check-coverage": false,
    "lines": 90,
    "statements": 90,
    "functions": 100,
    "branches": 75,
    "reporter": [
      "lcov",
      "text-summary",
      "text",
      "html"
    ],
    "all": true,
    "report-dir": "./coverage"
  }
}
